# APKs and signing material are local-only and must not enter Git.
*.apk
*.aab
*.ipa
*.idsig
*.p12
*.jks
*.keystore

# Build output and local tooling state.
.gradle/
build/
dist/
__pycache__/
.venv/
*.log

# Device captures may contain personal/device information.
captures/

# Local server database contains account hashes and private save data.
server/instance/
*.sqlite3
*.sqlite3.bak-*

# Scratch files used during device/protocol inspection.
.tmp_*

# 后台日志监听产物
.tmp-serverlog.txt
